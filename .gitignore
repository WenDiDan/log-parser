# ============================================================
# LogParser 版本控制忽略规则
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# ---- PyInstaller 构建产物 ----
build/
dist/
*.manifest

# ---- 发布产物：exe 体积大不入库（清单 version.json 与指南要入库）----
github-release/*.exe
gitee-release/**/*.exe
*.zip

# ---- 敏感信息：私人令牌绝不入库 ----
gitee_token.txt
gitee_token*
*.token

# ---- 发布目标：每台机器可能不同（在发布工具「发布目标设置…」里改）----
release_config.json

# ---- 运行期/测试生成 ----
_mock_logs/
*.log

# ---- 开发期间的临时文件 ----
# 验证用的脚本 / 截图，用完即删。曾因自动提交被误扫进版本库一次，
# 显式声明以免再犯。
_t_*
_shot_*

# ---- Windows 保留名产生的垃圾文件（防御性声明）----
nul
con
aux

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini
